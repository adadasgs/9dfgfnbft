# Telegram bot token from @BotFather
BOT_TOKEN=

# Telegram API credentials from https://my.telegram.org
API_ID=
API_HASH=
# Telethon StringSession for a user account (keep private)
SESSION_STRING=

# Destination group where results are published (example: -1001234567890)
DESTINATION_CHAT_ID=

# Optional source group to scan members from (not the destination group)
SCAN_SOURCE_CHAT=

# Optional comma-separated usernames/IDs to scan instead of/in addition to source group
SCAN_USERS=

# Scan interval in seconds
SCAN_INTERVAL=900
